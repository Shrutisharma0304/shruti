#include <stdio.h>

int main() {
    int mat[100][100];
    int n, i, j, k;
    bool distinct = true;

    printf("Enter the size of the square matrix (n x n, max 100): ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid size.\n");
        return 1;
    }

    
    printf("Enter %d elements of the matrix:\n", n * n);
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            printf("Element [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
        }
    }

    
    for (i = 0; i < n; i++) {
        for (j = i + 1; j < n; j++) {
            if (mat[i][i] == mat[j][j]) {
                distinct = false;
                break;
            }
        }
        if (!distinct) break;
    }

    
    printf("\nMatrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            printf("%d ", mat[i][j]);
        }
        printf("\n");
    }

    
    printf("\nDiagonal elements: ");
    for (i = 0; i < n; i++) {
        printf("%d ", mat[i][i]);
    }
    printf("\n");

    
    if (distinct) {
        printf("All diagonal elements are distinct.\n");
    } else {
        printf("Diagonal elements are NOT all distinct.\n");
    }

    return 0;
}
