#include <stdio.h>

int main() {
    int n, i;
    int binary[32]; 
    int index = 0;

  
    printf("Enter a non-negative integer: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Please enter a non-negative integer.\n");
        return 0;
    }


    if (n == 0) {
        printf("Binary representation: 0\n");
        return 0;
    }

  
    while (n > 0) {
        binary[index++] = n % 2;
        n /= 2;
    }


    printf("Binary representation: ");
    for (i = index - 1; i >= 0; i--) {
        printf("%d", binary[i]);
    }
    printf("\n");

    return 0;
}
