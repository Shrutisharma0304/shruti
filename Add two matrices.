#include <stdio.h>

int main() {
    int A[100][100], B[100][100], C[100][100];
    int rows, cols, i, j;

    printf("Enter the number of rows (max 100): ");
    scanf("%d", &rows);

    printf("Enter the number of columns (max 100): ");
    scanf("%d", &cols);

    if (rows <= 0 || rows > 100 || cols <= 0 || cols > 100) {
        printf("Invalid dimensions.\n");
        return 1;
    }

    
    printf("Enter elements of first matrix (%d x %d):\n", rows, cols);
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("A[%d][%d]: ", i, j);
            scanf("%d", &A[i][j]);
        }
    }

  
    printf("\nEnter elements of second matrix (%d x %d):\n", rows, cols);
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("B[%d][%d]: ", i, j);
            scanf("%d", &B[i][j]);
        }
    }


    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            C[i][j] = A[i][j] + B[i][j];
        }
    }

  
    printf("\nSum of the two matrices:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("%d ", C[i][j]);
        }
        printf("\n");
    }

    return 0;
}
