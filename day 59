
#include <stdio.h>

int main()
{
    int n, k, i, sum = 0, maxSum;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter the value of k: ");
    scanf("%d", &k);

    if(k <= 0 || k > n)
    {
        printf("Invalid value of k");
        return 0;
    }

    // Calculate sum of first k elements
    for(i = 0; i < k; i++)
    {
        sum += arr[i];
    }

    maxSum = sum;

    // Check remaining subarrays using sliding window
    for(i = k; i < n; i++)
    {
        sum = sum + arr[i] - arr[i-k];

        if(sum > maxSum)
        {
            maxSum = sum;
        }
    }

    printf("Maximum subarray sum = %d", maxSum);

    return 0;
}
