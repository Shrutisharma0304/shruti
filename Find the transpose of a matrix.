#include <stdio.h>

int main() {
    int mat[100][100];
    int transpose[100][100];
    int rows, cols, i, j;

    printf("Enter the number of rows (max 100): ");
    scanf("%d", &rows);

    printf("Enter the number of columns (max 100): ");
    scanf("%d", &cols);

    if (rows <= 0 || rows > 100 || cols <= 0 || cols > 100) {
        printf("Invalid dimensions.\n");
        return 1;
    }

  
    printf("Enter %d elements of the matrix:\n", rows * cols);
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("Element [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
        }
    }

    
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            transpose[j][i] = mat[i][j];
        }
    }

  
    printf("\nOriginal Matrix:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("%d ", mat[i][j]);
        }
        printf("\n");
    }

    
    printf("\nTranspose of Matrix:\n");
    for (i = 0; i < cols; i++) {
        for (j = 0; j < rows; j++) {
            printf("%d ", transpose[i][j]);
        }
        printf("\n");
    }

    return 0;
}
