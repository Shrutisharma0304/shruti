#include <stdio.h>

int main() {
    int n, digit;
    long long product = 1;
    int foundOdd = 0;  

    printf("Enter an integer: ");
    scanf("%d", &n);

    if (n < 0) {
        n = -n;
    }

    if (n == 0) {
        printf("The number has no odd digits. Product = 0\n");
        return 0;
    }


    while (n > 0) {
        digit = n % 10;
        if (digit % 2 != 0) { 
            product *= digit;
            foundOdd = 1;
        }
        n /= 10;
    }

    if (!foundOdd) {
        printf("The number has no odd digits. Product = 0\n");
    } else {
        printf("Product of odd digits = %lld\n", product);
    }

    return 0;
}
