#include <stdio.h>

int main() {
    char bin[65]; 
    int i;

    
    printf("Enter a binary number (e.g., 101101): ");
    scanf("%64s", bin);

    
    for (i = 0; bin[i] != '\0'; i++) {
        if (bin[i] != '0' && bin[i] != '1') {
            printf("Invalid input. Please enter a binary number containing only 0s and 1s.\n");
            return 0;
        }
    }

    // Print 1's complement
    printf("1's complement: ");
    for (i = 0; bin[i] != '\0'; i++) {
        if (bin[i] == '0') {
            printf("1");
        } else {
            printf("0");
        }
    }
    printf("\n");

    return 0;
}
