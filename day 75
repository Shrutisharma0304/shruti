
#include <stdio.h>

int main()
{
    FILE *fp;
    char text[200];

    // Open existing file in append mode
    fp = fopen("info.txt", "a");

    if(fp == NULL)
    {
        printf("File cannot be opened!");
        return 1;
    }

    // Take new text from user
    printf("Enter a line of text to append: ");
    fgets(text, sizeof(text), stdin);

    // Append text to file
    fprintf(fp, "%s", text);

    // Close file
    fclose(fp);

    printf("Text successfully appended to info.txt");

    return 0;
}
