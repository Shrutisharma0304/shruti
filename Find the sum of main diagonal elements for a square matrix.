#include <stdio.h>

int main() {
    int mat[100][100];
    int n, i, j;
    long sum = 0;

    printf("Enter the size of the square matrix (n x n, max 100): ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid size.\n");
        return 1;
    }

    
    printf("Enter %d elements of the matrix:\n", n * n);
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            printf("Element [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
        }
    }

    
    for (i = 0; i < n; i++) {
        sum += mat[i][i];
    }

    
    printf("\nMatrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            printf("%d ", mat[i][j]);
        }
        printf("\n");
    }

    
    printf("\nMain diagonal elements: ");
    for (i = 0; i < n; i++) {
        printf("%d ", mat[i][i]);
    }
    printf("\nSum of main diagonal elements = %ld\n", sum);

    return 0;
}
