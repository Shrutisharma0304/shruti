
#include <stdio.h>

int main()
{
    FILE *fp;
    char name[50];
    int age;

    // Open file in write mode
    fp = fopen("info.txt", "w");

    if(fp == NULL)
    {
        printf("File cannot be opened!");
        return 1;
    }

    // Take user input
    printf("Enter your name: ");
    scanf("%s", name);

    printf("Enter your age: ");
    scanf("%d", &age);

    // Write data into file
    fprintf(fp, "Name: %s\nAge: %d", name, age);

    // Close file
    fclose(fp);

    printf("Data successfully saved to info.txt");

    return 0;
}
