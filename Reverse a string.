#include <stdio.h>

int main() {
    char str[1000];
    int i = 0, j, temp;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    
    while (str[i] != '\0') {
        i++;
    }
    int len = i;

    
    if (len > 0 && str[len - 1] == '\n') {
        len--;
    }

    
    i = 0;
    j = len - 1;
    while (i < j) {
        temp = str[i];
        str[i] = str[j];
        str[j] = temp;
        i++;
        j--;
    }

    printf("Reversed string: %s\n", str);

    return 0;
}
