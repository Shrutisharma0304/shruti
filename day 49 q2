#include <stdio.h>
#include <string.h>

int main()
{
    char name[100];
    int i, start = 0, last = 0;

    printf("Enter your full name: ");
    fgets(name, sizeof(name), stdin);

    name[strcspn(name, "\n")] = '\0';

    for (i = 0; name[i] != '\0'; i++)
    {
        if (name[i] == ' ')
        {
            printf("%c. ", name[start]);
            start = i + 1;
            last = start;
        }
    }

    printf("%s\n", name + last);

    return 0;
}
