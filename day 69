
#include <stdio.h>

int main()
{
    int n, i, repeated = -1;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    int arr[n];
    int visited[1000] = {0};

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);

        if(visited[arr[i]] == 1)
        {
            repeated = arr[i];
        }
        else
        {
            visited[arr[i]] = 1;
        }
    }

    printf("Repeated element = %d", repeated);

    return 0;
}
