#include <stdio.h>

int main() {
    int arr[101];     
    int n, i, key;
    int pos;

    printf("Enter the number of elements (max 100): ");
    scanf("%d", &n);

    if (n < 0 || n > 100) {
        printf("Invalid number of elements.\n");
        return 1;
    }

    
    printf("Enter %d elements in ascending order:\n", n);
    for (i = 0; i < n; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }

  
    printf("\nEnter the element to insert: ");
    scanf("%d", &key);

    
    pos = n;  
    for (i = 0; i < n; i++) {
        if (key < arr[i]) {
            pos = i;
            break;
        }
    }

  
    for (i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    
    arr[pos] = key;
    n = n + 1;  // increase size

  
    printf("\nArray after insertion:\n");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
