#include <stdio.h>

int factorial(int d) {
    int f = 1;
    while (d > 1) {
        f *= d;
        d--;
    }
    return f;
}

int main() {
    int n, original, digit;
    int sum = 0;

  
    printf("Enter a positive integer: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Please enter a positive integer.\n");
        return 0;
    }

    original = n;

  
    while (n > 0) {
        digit = n % 10;
        sum += factorial(digit);
        n /= 10;
    }

    if (sum == original) {
        printf("%d is a strong number.\n", original);
    } else {
        printf("%d is not a strong number.\n", original);
    }

    return 0;
}
