#include <stdio.h>

int main() {
    int n, original, reversed = 0, digit;

    printf("Enter an integer: ");
    scanf("%d", &n);

    original = n;

    if (n < 0) {
        n = -n;
    }


    while (n > 0) {
        digit = n % 10;
        reversed = reversed * 10 + digit;
        n /= 10;
    }

    
    if (original < 0) {
        reversed = -reversed;
    }

    printf("Original number: %d\n", original);
    printf("Reversed number: %d\n", reversed);

    return 0;
}
