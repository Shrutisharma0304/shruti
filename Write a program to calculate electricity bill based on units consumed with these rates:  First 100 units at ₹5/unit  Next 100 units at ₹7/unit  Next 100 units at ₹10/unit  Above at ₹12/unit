#include <stdio.h>

int main() {
    int units;
    float bill = 0.0f;

    printf("Enter number of units consumed: ");
    scanf("%d", &units);

    if (units < 0) {
        printf("Invalid input. Units cannot be negative.\n");
        return 0;
    }

    if (units <= 100) {
        bill = units * 5.0f;
    } else {
        bill = 100 * 5.0f; 

        
        if (units <= 200) {
            bill += (units - 100) * 7.0f;
        } else {
            bill += 100 * 7.0f;  

          
            if (units <= 300) {
                bill += (units - 200) * 10.0f;
            } else {
                bill += 100 * 10.0f;  

                bill += (units - 300) * 12.0f;
            }
        }
    }

    printf("Electricity bill: ₹%.2f\n", bill);

    return 0;
}
