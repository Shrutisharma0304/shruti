#include <stdio.h>

int main() {
    int arr[100];
    int n, i;
    long sum = 0;  

    printf("Enter the number of elements (max 100): ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid number of elements.\n");
        return 0;
    }


    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }

    
    for (i = 0; i < n; i++) {
        sum += arr[i];
    }

  
    printf("\nSum of array elements = %ld\n", sum);

    return 0;
}
