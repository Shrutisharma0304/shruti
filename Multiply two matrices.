#include <stdio.h>

int main() {
    int A[100][100], B[100][100], C[100][100];
    int r1, c1, r2, c2;
    int i, j, k;

    
    printf("Enter number of rows and columns for first matrix (r1 c1): ");
    scanf("%d %d", &r1, &c1);

    
    printf("Enter number of rows and columns for second matrix (r2 c2): ");
    scanf("%d %d", &r2, &c2);

    if (r1 <= 0 || r1 > 100 || c1 <= 0 || c1 > 100 ||
        r2 <= 0 || r2 > 100 || c2 <= 0 || c2 > 100) {
        printf("Invalid dimensions.\n");
        return 1;
    }

    
    if (c1 != r2) {
        printf("Matrix multiplication not possible: columns of first (%d) != rows of second (%d).\n", c1, r2);
        return 1;
    }

    
    printf("Enter elements of first matrix (%d x %d):\n", r1, c1);
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c1; j++) {
            printf("A[%d][%d]: ", i, j);
            scanf("%d", &A[i][j]);
        }
    }

    
    printf("\nEnter elements of second matrix (%d x %d):\n", r2, c2);
    for (i = 0; i < r2; i++) {
        for (j = 0; j < c2; j++) {
            printf("B[%d][%d]: ", i, j);
            scanf("%d", &B[i][j]);
        }
    }

  
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c2; j++) {
            C[i][j] = 0;
            for (k = 0; k < c1; k++) {  // or k < r2, since c1 == r2
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }


    printf("\nResultant matrix (A * B):\n");
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c2; j++) {
            printf("%d ", C[i][j]);
        }
        printf("\n");
    }

    return 0;
}
