#include <stdio.h>

int main() {
    float P, R, T;
    float SI, CI, amount;

    printf("Enter principal amount: ");
    scanf("%f", &P);

    printf("Enter rate of interest (per annum, in %%): ");
    scanf("%f", &R);

    printf("Enter time (in years): ");
    scanf("%f", &T);

    SI = (P * R * T) / 100.0f;

    amount = P * pow(1 + R / 100.0f, T);
    CI = amount - P;

    printf("Simple Interest: %.2f\n", SI);
    printf("Compound Interest: %.2f\n", CI);
    printf("Total Amount with Compound Interest: %.2f\n", amount);

    return 0;
}
