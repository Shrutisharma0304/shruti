
#include <stdio.h>

int main()
{
    int n, i, j;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Previous Greater Elements:\n");

    for(i = 0; i < n; i++)
    {
        int prev = -1;

        for(j = i - 1; j >= 0; j--)
        {
            if(arr[j] > arr[i])
            {
                prev = arr[j];
                break;
            }
        }

        printf("%d -> %d\n", arr[i], prev);
    }

    return 0;
}
