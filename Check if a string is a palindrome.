#include <stdio.h>


int main() {
    char str[1000];
    int i = 0, j;
    bool isPalindrome = true;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    
    while (str[i] != '\0') {
        i++;
    }
    int len = i;

    
    if (len > 0 && str[len - 1] == '\n') {
        len--;
    }


    i = 0;
    j = len - 1;
    while (i < j) {
        if (str[i] != str[j]) {
            isPalindrome = false;
            break;
        }
        i++;
        j--;
    }

    if (isPalindrome) {
        printf("The string is a palindrome.\n");
    } else {
        printf("The string is NOT a palindrome.\n");
    }

    return 0;
}
