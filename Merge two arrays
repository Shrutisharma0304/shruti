#include <stdio.h>

int main() {
    int arr1[100], arr2[100], merged[200];
    int n1, n2, i;

  
    printf("Enter the number of elements in first array (max 100): ");
    scanf("%d", &n1);

    if (n1 <= 0 || n1 > 100) {
        printf("Invalid number of elements for first array.\n");
        return 1;
    }

    printf("Enter %d elements of first array:\n", n1);
    for (i = 0; i < n1; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr1[i]);
    }


    printf("\nEnter the number of elements in second array (max 100): ");
    scanf("%d", &n2);

    if (n2 <= 0 || n2 > 100) {
        printf("Invalid number of elements for second array.\n");
        return 1;
    }

    printf("Enter %d elements of second array:\n", n2);
    for (i = 0; i < n2; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr2[i]);
    }

    
    for (i = 0; i < n1; i++) {
        merged[i] = arr1[i];
    }
    for (i = 0; i < n2; i++) {
        merged[n1 + i] = arr2[i];
    }

    
    printf("\nMerged array:\n");
    for (i = 0; i < n1 + n2; i++) {
        printf("%d ", merged[i]);
    }
    printf("\n");

    return 0;
}
